{
  "name": "@holmes1560/templar-os",
  "version": "1.0.0",
  "private": false,
  "description": "TEMPLAR OS interactive portfolio OS, agent CLI, and MCP server",
  "bin": {
    "templar-os": "./dist/cli/index.mjs",
    "portfolio-agent": "./dist/cli/index.mjs"
  },
  "files": [
    "dist",
    "skills",
    "README.md"
  ],
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "tsup src/cli/index.ts src/mcp/server.ts --format esm --clean && prisma generate && next build",
    "build:cli": "tsup src/cli/index.ts src/mcp/server.ts --format esm --clean",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:snapshot": "tsx scripts/snapshot.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "mcp:server": "tsx src/mcp/server.ts",
    "cli": "tsx src/cli/index.ts",
    "test:e2e": "tsx scripts/test-e2e.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@google/genai": "^2.21.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@prisma/client": "^6.19.3",
    "motion": "^13.2.0",
    "next": "16.3.4",
    "openai": "^7.12.1",
    "prisma": "^6.19.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "packageManager": "pnpm@9.15.4",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
