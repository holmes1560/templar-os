// TEMPLAR OS — portfolio CMS schema
//
// Design notes:
//  · Project and Application are deliberately separate (§5). A Project is the
//    work; an Application is how that work is represented inside the OS. One
//    project can surface as several applications, and system apps (Terminal,
//    Settings) are applications with no project at all.
//  · AI-generated prose is stored beside, never on top of, human-edited prose
//    (§20). A re-analysis writes the ai* columns; the admin's own text is
//    untouched unless they explicitly adopt the suggestion.
//  · Technologies are a real relation because they're reusable and filterable.
//    Features/challenges/lessons stay as ordered text arrays — they're prose
//    belonging to one project, not entities worth their own table.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── auth ───────────────────────────────

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  auditLogs AuditLog[]
  revisions Revision[]

  @@map("admin_users")
}

// ───────────────────────────── projects ─────────────────────────────

enum Category {
  WEB
  MOBILE
  CYBERSECURITY
  AI
  HARDWARE
  EXPERIMENTS
}

/// Where the source actually lives. Drives whether a repo link renders at all.
enum RepoVisibility {
  PUBLIC
  PRIVATE
  LOCAL
}

enum ProjectStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Project {
  id   String @id @default(cuid())
  slug String @unique
  name String

  /// what the admin has approved — this is what the portfolio renders
  shortDescription String
  longDescription  String

  /// what the importer last suggested; never overwrites the two above (§20)
  aiShortDescription String?
  aiLongDescription  String?
  aiGeneratedAt      DateTime?

  category Category
  period   String?
  team     String?

  githubUrl       String?
  repositoryOwner String?
  repositoryName  String?
  repoVisibility  RepoVisibility @default(LOCAL)

  /// hosted is explicit (§6): a liveUrl may exist while hosting is switched off
  hosted  Boolean @default(false)
  liveUrl String?
  docsUrl String?

  featured Boolean       @default(false)
  status   ProjectStatus @default(DRAFT)

  /// GitHub linkage. The numeric repo id is GitHub's stable identifier —
  /// repositories get renamed and moved between owners, and a name-based
  /// link would silently orphan itself when that happens (§12).
  githubRepoId  BigInt?
  defaultBranch String?
  /// head SHA at the last analysis; sync compares against it so an unchanged
  /// repository costs zero AI calls (§14)
  lastAnalyzedSha String?
  lastSyncedAt    DateTime?

  /// honesty fields — surfaced in the UI, never silently dropped
  clientWork Boolean @default(false)
  caveat     String?

  features   String[]
  challenges String[]
  learned    String[]
  skills     String[]

  /// engineering experience & lessons learned (§13)
  role             String?
  architecture     String?
  failedApproaches String[]
  problemSolutions String[]
  outcome          String?
  order            Int            @default(0)
  visible          Boolean        @default(true)
  isAiGenerated    Boolean        @default(false)
  aiOrigin         String?

  technologies ProjectTechnology[]
  applications Application[]
  assets       Asset[]
  importJobs   ImportJob[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, featured])
  @@index([category])
  @@map("projects")
}

model Technology {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  projects ProjectTechnology[]

  @@map("technologies")
}

model ProjectTechnology {
  projectId    String
  technologyId String
  order        Int    @default(0)

  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  technology Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@id([projectId, technologyId])
  @@map("project_technologies")
}

// ─────────────────────────── applications ───────────────────────────

enum LaunchMode {
  /// embed the live deployment in a window
  IFRAME
  /// open the real site in a new tab
  EXTERNAL
  /// a component built into the OS (Terminal, Settings, Projects…)
  INTERNAL
  /// a self-contained demo that needs no live backend
  DEMO
}

model Application {
  id String @id @default(cuid())

  /// null for system apps that aren't tied to a project
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// stable key the OS routes on — e.g. "terminal", "projects", "live-taas"
  appKey String @unique
  name   String
  icon   String @default("folder")

  launchMode LaunchMode @default(INTERNAL)
  /// resolved at launch time, never compiled into the frontend (§6)
  url        String?

  enabled        Boolean @default(true)
  desktopVisible Boolean @default(true)

  /// desktop placement: workspace + grid cell index, not pixels
  workspace Int @default(0)
  cell      Int @default(0)

  windowWidth  Int     @default(760)
  windowHeight Int     @default(520)
  resizable    Boolean @default(true)
  maximizable  Boolean @default(true)
  minimizable  Boolean @default(true)

  healthChecks HealthCheck[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled, desktopVisible, workspace])
  @@map("applications")
}

// ───────────────────────────── assets ──────────────────────────────

enum AssetKind {
  ICON
  SCREENSHOT
  LOGO
  ARCHITECTURE
  VIDEO
  OTHER
}

model Asset {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  kind  AssetKind @default(SCREENSHOT)
  url   String
  alt   String?
  order Int       @default(0)

  createdAt DateTime @default(now())

  @@index([projectId, kind])
  @@map("assets")
}

// ────────────────────── AI import pipeline (§9) ─────────────────────

enum ImportStatus {
  PENDING
  ANALYZING
  READY
  APPROVED
  FAILED
}

model ImportJob {
  id String @id @default(cuid())

  repoUrl String
  liveUrl String?

  status ImportStatus @default(PENDING)
  /// the validated structured analysis, held for admin review before publish (§12)
  analysis Json?
  error    String?

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("import_jobs")
}

// ───────────────────────── health & audit ──────────────────────────

model HealthCheck {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  url        String
  ok         Boolean
  statusCode Int?
  latencyMs  Int?
  checkedAt  DateTime @default(now())

  @@index([applicationId, checkedAt])
  @@map("health_checks")
}

model AuditLog {
  id      String     @id @default(cuid())
  actorId String?
  actor   AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  action   String
  entity   String
  entityId String?
  meta     Json?

  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@map("audit_logs")
}

// ──────────────────────── site configuration ───────────────────────

/// Key/value so identity, links and CV path stop living in source.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("settings")
}

// ──────────────────── GitHub integration (§4) ───────────────────

/// The connected GitHub account. Single row in practice — one admin.
///
/// Tokens are stored encrypted (AES-256-GCM) rather than as plaintext: this
/// row grants read access to the owner's repositories, so a database dump,
/// a stray log line or a screenshot of a DB browser must not be enough to
/// use it.
model GitHubConnection {
  id String @id @default(cuid())

  /// GitHub account this connection belongs to
  accountLogin String
  accountId    BigInt
  avatarUrl    String?

  /// App installation granting per-repository access
  installationId BigInt?

  /// AES-256-GCM ciphertext — never the raw token
  accessTokenEnc  String
  refreshTokenEnc String?
  expiresAt       DateTime?

  scopes String[]

  /// set when GitHub rejects the credential, so the UI can ask for
  /// reauthorization instead of failing repeatedly
  invalidatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("github_connections")
}

// ────────────────────────────── profile ─────────────────────────────

model Profile {
  id                 String   @id @default(cuid())
  fullName           String
  shortName          String
  title              String
  tagline            String
  bio                String
  aboutMe            String
  location           String
  availabilityStatus String   @default("Open to opportunities")
  careerInterests    String[]
  whatImDrawnTo      String[]
  howIWorkWithAi     String?
  avatarUrl          String?
  email              String?
  phone              String?
  websiteUrl         String?
  githubUrl          String?
  linkedinUrl        String?
  twitterUrl         String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("profiles")
}

// ────────────────────────────── skills ──────────────────────────────

model SkillCategory {
  id     String  @id @default(cuid())
  name   String  @unique
  slug   String  @unique
  order  Int     @default(0)
  skills Skill[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("skill_categories")
}

model Skill {
  id           String        @id @default(cuid())
  categoryId   String
  category     SkillCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  proficiency  Int?          // 1-100 percentage
  technologies String[]
  order        Int           @default(0)
  featured     Boolean       @default(false)
  visible      Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([categoryId, order])
  @@map("skills")
}

// ───────────────────────────── timeline ─────────────────────────────

enum TimelineType {
  UNIVERSITY
  INTERNSHIP
  EMPLOYMENT
  PROJECT
  CERTIFICATION
  MILESTONE
  LEARNING
}

model TimelineEntry {
  id                  String       @id @default(cuid())
  title               String
  type                TimelineType @default(MILESTONE)
  organization        String?
  startDate           String
  endDate             String?
  isCurrent           Boolean      @default(false)
  shortDescription    String
  detailedDescription String?
  technologies        String[]
  skills              String[]
  relatedProjectIds   String[]
  icon                String       @default("milestone")
  color               String?
  order               Int          @default(0)
  visible             Boolean      @default(true)
  isAiGenerated       Boolean      @default(false)
  aiOrigin            String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([type, order])
  @@map("timeline_entries")
}

// ──────────────────────────── experience ────────────────────────────

model Experience {
  id               String   @id @default(cuid())
  organization     String
  role             String
  employmentType   String?  // Full-time, Internship, Contract, Freelance
  location         String?
  startDate        String
  endDate          String?
  isCurrent        Boolean  @default(false)
  description      String
  responsibilities String[]
  achievements     String[]
  technologies     String[]
  order            Int      @default(0)
  visible          Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("experiences")
}

// ───────────────────────────── education ────────────────────────────

model Education {
  id           String   @id @default(cuid())
  institution  String
  degree       String
  fieldOfStudy String?
  startDate    String
  endDate      String?
  isCurrent    Boolean  @default(false)
  description  String?
  achievements String[]
  order        Int      @default(0)
  visible      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("educations")
}

// ─────────────────────────── certifications ─────────────────────────

model Certification {
  id            String   @id @default(cuid())
  name          String
  issuer        String
  issueDate     String?
  expiryDate    String?
  credentialUrl String?
  credentialId  String?
  description   String?
  order         Int      @default(0)
  visible       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("certifications")
}

// ─────────────────────────── achievements ───────────────────────────

model Achievement {
  id           String   @id @default(cuid())
  title        String
  description  String
  date         String?
  organization String?
  linkUrl      String?
  order        Int      @default(0)
  visible      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("achievements")
}

// ───────────────────────────── resumes ──────────────────────────────

model ResumeRecord {
  id         String   @id @default(cuid())
  version    String
  fileName   String
  filePath   String
  fileSize   Int?
  mimeType   String?  @default("application/pdf")
  isActive   Boolean  @default(true)
  uploadedAt DateTime @default(now())

  @@map("resume_records")
}

// ─────────────────────────── social links ───────────────────────────

model SocialLink {
  id       String  @id @default(cuid())
  platform String  // GitHub, LinkedIn, X, Email, etc.
  label    String
  url      String
  username String?
  icon     String  @default("globe")
  order    Int     @default(0)
  visible  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("social_links")
}

// ───────────────────────────── api keys ─────────────────────────────

enum ApiKeyRole {
  READ_ONLY
  CONTENT_EDITOR
  PUBLISHER
  FULL_AGENT
  CUSTOM
}

model ApiKey {
  id              String     @id @default(cuid())
  name            String
  keyPrefix       String
  keyHash         String     @unique
  role            ApiKeyRole @default(READ_ONLY)
  scopes          String[]
  rateLimitPerMin Int        @default(60)
  lastUsedAt      DateTime?
  expiresAt       DateTime?
  revokedAt       DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  revisions Revision[]
  drafts    Draft[]

  @@map("api_keys")
}

// ────────────────────────────── drafts ──────────────────────────────

enum DraftStatus {
  PENDING
  APPROVED
  REJECTED
  PUBLISHED
}

enum DraftAction {
  CREATE
  UPDATE
  DELETE
}

model Draft {
  id            String      @id @default(cuid())
  entityType    String      // project, timeline, skill, profile, experience, etc.
  entityId      String?     // null if new entity
  action        DraftAction @default(CREATE)
  title         String
  summary       String?
  data          Json
  previousData  Json?
  status        DraftStatus @default(PENDING)
  isAiGenerated Boolean     @default(true)
  aiOrigin      String?
  reviewNotes   String?

  createdByApiKeyId String?
  apiKey            ApiKey?   @relation(fields: [createdByApiKeyId], references: [id], onDelete: SetNull)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  reviewedAt DateTime?

  @@index([status, entityType])
  @@map("drafts")
}

// ──────────────────────────── revisions ─────────────────────────────

model Revision {
  id            String   @id @default(cuid())
  entityType    String   // project, timeline, skill, profile, etc.
  entityId      String
  changeType    String   // CREATE, UPDATE, PUBLISH, ARCHIVE, REVERT, DELETE
  summary       String?
  previousValue Json?
  newValue      Json?

  actorId  String?
  actor    AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  apiKeyId String?
  apiKey   ApiKey?    @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)

  isAiGenerated Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([entityType, entityId])
  @@map("revisions")
}

