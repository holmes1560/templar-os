# Local development database (Docker or Neon)
DATABASE_URL="postgresql://templar:templar@localhost:5439/templar_os?schema=public"

# Session signing key (min 32 chars)
AUTH_SECRET="your_auth_secret"

# Encrypts secrets held in the database (GitHub tokens)
ENCRYPTION_KEY="your_encryption_key"

# GitHub App Integration (Optional for manual projects, required for repo sync)
GITHUB_APP_ID=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_CALLBACK_URL="http://localhost:3100/api/github/callback"
GITHUB_PRIVATE_KEY=""

# AI Repository Analyzer (Gemini default, Anthropic optional)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"
ANTHROPIC_API_KEY=""
