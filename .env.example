# Production / Neon PostgreSQL
DATABASE_URL="postgresql://user:password@ep-xyz-pooler.neon.tech/templar_os?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xyz.neon.tech/templar_os?sslmode=require"

# Session signing key & admin secret (min 32 chars)
AUTH_SECRET="your_auth_secret_at_least_32_characters_long"
ADMIN_SESSION_SECRET="your_admin_session_secret_at_least_32_characters"

# Encrypts secrets held in the database (GitHub tokens)
ENCRYPTION_KEY="your_encryption_key_at_least_32_characters_long"

# Portfolio Public URL (used by MCP and agent tools)
PORTFOLIO_API_URL="https://your-domain.vercel.app"

# Production / Dev Seed Admin API Key
DEV_API_KEY="tpl_live_your_custom_agent_api_key_here"

# GitHub App Integration (Optional for manual projects, required for repo sync)
GITHUB_APP_ID=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_CALLBACK_URL="https://your-domain.vercel.app/api/github/callback"
GITHUB_PRIVATE_KEY=""

# AI Repository Analyzer (Gemini default, Anthropic optional)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
ANTHROPIC_API_KEY=""
